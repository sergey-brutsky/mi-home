<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>MiHomeLib</Title>
    <TargetFrameworks>netstandard2.0;net481</TargetFrameworks>
    <PackageId>MiHomeLib</PackageId>
    <MinClientVersion>2.6</MinClientVersion>
    <Authors>Sergey Brutsky</Authors>
    <Description>C# library for using xiaomi/aqara smart gateways/devices in your scenarious</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
Added support for Xiaomi Smart Switch DHKG01CM (zimi.switch.dhkg01) BLE Mesh, with control of on/off, toggle, wireless mode, indicator light and power-change
    </PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright 2017-2026 (c) Sergey Brutsky. All rights reserved.</Copyright>
    <PackageTags>xiaomi aqara xiaomi-smart-home xiaomi-gateway2 multimode-gateway multimode-gateway2 smarthome 
    csharp netstandard2 netcore2 mihome</PackageTags>
    <RepositoryUrl>https://github.com/sergey-brutsky/mi-home</RepositoryUrl>
    <PackageIcon>gateway.jpeg</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Version>2.3.12</Version>  
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="MQTTnet" Version="4.3.6.1152" />
  </ItemGroup>
  <ItemGroup>
    <None Include="gateway.jpeg" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
