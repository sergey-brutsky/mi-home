<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>MiHomeLib</Title>
    <TargetFrameworks>netstandard2.0;net462;net10.0</TargetFrameworks>
    <PackageId>MiHomeLib</PackageId>
    <MinClientVersion>2.6</MinClientVersion>
    <Authors>Sergey Brutsky</Authors>
    <Description>C# library for using xiaomi/aqara smart gateways/devices in your scenarious</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
This is a breaking changes release. Review the release notes and migration guide before upgrading.
Release notes and breaking changes: https://github.com/sergey-brutsky/mi-home/wiki/Release-Notes-3.0
Migration guide: https://github.com/sergey-brutsky/mi-home/wiki/Migration-3.0
    </PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright 2017-2026 (c) Sergey Brutsky. All rights reserved.</Copyright>
    <PackageTags>xiaomi aqara xiaomi-smart-home xiaomi-gateway2 multimode-gateway multimode-gateway2 smarthome 
    csharp netstandard2 netcore2 mihome</PackageTags>
    <RepositoryUrl>https://github.com/sergey-brutsky/mi-home</RepositoryUrl>
    <PackageIcon>gateway.jpeg</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Version>3.0.0</Version>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="gateway.jpeg" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
